# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Recommended: Google Apps Script Web App URL for Google Spreadsheet database (zero OAuth / zero Firebase)
# Deploy the provided Code.gs inside your RT Google Spreadsheet as a Web App and paste the /exec URL here.
# VITE_SHEETS_WEBAPP_URL="https://script.google.com/macros/s/.../exec"

# Optional: Direct Google Identity Services OAuth Client ID (only if using direct OAuth mode instead of Apps Script)
# VITE_GOOGLE_OAUTH_CLIENT_ID=""
