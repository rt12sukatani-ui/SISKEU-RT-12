{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authorized RT administrator / treasurer role record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["admin", "ketua_rt", "sekretaris", "bendahara", "pengurus_lain"] },
        "permissions": { "type": "array", "description": "Explicitly granted RBAC permissions" },
        "registryId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    },
    "ResidentPublic": {
      "title": "ResidentPublic",
      "description": "Non-PII resident directory record for RT dues transparency",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 30 },
        "accountRole": { "type": "string", "enum": ["warga", "pengurus"] },
        "pengurusPosition": { "type": "string", "enum": ["ketua_rt", "sekretaris", "bendahara", "pengurus_lain"] },
        "permissions": { "type": "array", "description": "Granted RBAC permissions for pengurus" },
        "registryId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "houseBlock": { "type": "string", "minLength": 1, "maxLength": 30 },
        "residentStatus": { "type": "string", "enum": ["tetap", "kontrak", "pengurus"] },
        "familyStatus": { "type": "string", "enum": ["umum", "khusus"] },
        "familyStatusLog": { "type": "array", "description": "Chronological YYYY-MM:status change history locking prior months" },
        "lastPaidMonth": { "type": "string", "maxLength": 7 },
        "elderlyMode": { "type": "boolean" },
        "communityId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "houseBlock", "residentStatus", "elderlyMode", "communityId", "createdAt", "updatedAt"]
    },
    "ResidentPrivateInfo": {
      "title": "ResidentPrivateInfo",
      "description": "Encrypted and isolated PII and health profile for a resident",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "docType": { "type": "string", "enum": ["profile", "health"] },
        "encryptedPayload": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "encryptionAlg": { "type": "string", "enum": ["AES-GCM-256"] },
        "shareInEmergency": { "type": "boolean" },
        "emergencySummary": { "type": "string", "maxLength": 400 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "docType", "encryptedPayload", "encryptionAlg", "updatedAt"]
    },
    "KasTransaction": {
      "title": "KasTransaction",
      "description": "RT cash flow entry (resident dues submission or admin expense)",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string", "enum": ["iuran_bulanan", "donasi", "kebersihan", "keamanan", "sosial", "perbaikan", "lainnya"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "amount": { "type": "number" },
        "billingMonth": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "residentUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "residentName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "houseBlock": { "type": "string", "minLength": 1, "maxLength": 30 },
        "familyStatus": { "type": "string", "enum": ["umum", "khusus"] },
        "paymentMethod": { "type": "string", "enum": ["transfer", "qris", "tunai"] },
        "proofImageData": { "type": "string", "maxLength": 350000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "kurang_bayar"] },
        "rejectionReason": { "type": "string", "maxLength": 200 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 300 },
        "communityId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "category", "title", "amount", "billingMonth", "residentUid", "residentName", "houseBlock", "paymentMethod", "status", "communityId", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Real-time neighborhood announcement and payment reminder broadcast",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "body": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "category": { "type": "string", "enum": ["penting", "keuangan", "kegiatan", "keamanan", "kesehatan"] },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "communityId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "category", "priority", "authorUid", "authorName", "communityId", "createdAt", "updatedAt"]
    },
    "EmergencyAlert": {
      "title": "EmergencyAlert",
      "description": "One-tap SOS alert with medical profile integration",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "houseBlock": { "type": "string", "minLength": 1, "maxLength": 30 },
        "emergencyType": { "type": "string", "enum": ["medis", "keamanan", "kebakaran", "bencana"] },
        "description": { "type": "string", "maxLength": 400 },
        "locationText": { "type": "string", "maxLength": 160 },
        "medicalSummary": { "type": "string", "maxLength": 400 },
        "emergencyContact": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "responding", "resolved"] },
        "responderName": { "type": "string", "maxLength": 80 },
        "communityId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUid", "reporterName", "houseBlock", "emergencyType", "status", "communityId", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Targeted user notification for dues verification and reminders",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "message": { "type": "string", "minLength": 2, "maxLength": 400 },
        "type": { "type": "string", "enum": ["payment_approved", "payment_rejected", "payment_reminder", "emergency", "announcement"] },
        "isRead": { "type": "boolean" },
        "relatedId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUid", "senderUid", "title", "message", "type", "isRead", "createdAt"]
    },
    "RtSettings": {
      "title": "RtSettings",
      "description": "Neighborhood RT financial and emergency configuration",
      "type": "object",
      "properties": {
        "rtName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "rwName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kelurahan": { "type": "string", "minLength": 1, "maxLength": 80 },
        "monthlyDuesAmount": { "type": "number" },
        "dueDayOfMonth": { "type": "number" },
        "bankName": { "type": "string", "maxLength": 60 },
        "bankAccountNumber": { "type": "string", "maxLength": 40 },
        "bankAccountHolder": { "type": "string", "maxLength": 80 },
        "emergencyPhoneRT": { "type": "string", "maxLength": 30 },
        "emergencyPhoneMedical": { "type": "string", "maxLength": 30 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rtName", "rwName", "kelurahan", "monthlyDuesAmount", "dueDayOfMonth", "updatedBy", "updatedAt"]
    },
    "BannerSlide": {
      "title": "BannerSlide",
      "description": "Admin-uploaded community banner photo slide shown on login and home gallery",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 80 },
        "subtitle": { "type": "string", "maxLength": 160 },
        "imageData": { "type": "string", "minLength": 20, "maxLength": 450000 },
        "sortOrder": { "type": "number" },
        "uploadedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "communityId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subtitle", "imageData", "sortOrder", "uploadedBy", "communityId", "createdAt", "updatedAt"]
    },
    "ResidentRegistryEntry": {
      "title": "ResidentRegistryEntry",
      "description": "Master neighborhood resident database entry used to verify account registration",
      "type": "object",
      "properties": {
        "registryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "houseBlock": { "type": "string", "minLength": 1, "maxLength": 30 },
        "role": { "type": "string", "enum": ["warga", "pengurus"] },
        "pengurusPosition": { "type": "string", "enum": ["ketua_rt", "sekretaris", "bendahara", "pengurus_lain"] },
        "permissions": { "type": "array", "description": "Granted RBAC permissions for pengurus" },
        "residentStatus": { "type": "string", "enum": ["tetap", "kontrak", "pengurus"] },
        "familyStatus": { "type": "string", "enum": ["umum", "khusus"] },
        "claimedUid": { "type": "string", "maxLength": 128 },
        "claimedUsername": { "type": "string", "maxLength": 30 },
        "communityId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["registryId", "fullName", "houseBlock", "role", "residentStatus", "familyStatus", "claimedUid", "communityId", "createdBy", "createdAt", "updatedAt"]
    },
    "UserAccountLookup": {
      "title": "UserAccountLookup",
      "description": "Username-to-UID and role lookup table for registered neighborhood accounts",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["warga", "pengurus"] },
        "registryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "role", "registryId", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "RT admin and treasurer authorizations"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/ResidentPublic" },
      "description": "Public community resident directory (no PII)"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/ResidentPrivateInfo" },
      "description": "AES-256-GCM encrypted PII and health profile isolated per resident"
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/KasTransaction" },
      "description": "Transparent neighborhood treasury ledger and dues proof uploads"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Real-time neighborhood announcements and payment reminders"
    },
    "/emergencies/{emergencyId}": {
      "schema": { "$ref": "#/entities/EmergencyAlert" },
      "description": "Real-time one-tap emergency SOS alerts with medical info"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Targeted notifications for transaction status and dues reminders"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/RtSettings" },
      "description": "Neighborhood RT treasury and emergency configuration"
    },
    "/slides/{slideId}": {
      "schema": { "$ref": "#/entities/BannerSlide" },
      "description": "Public neighborhood banner slideshow photos managed by RT admins"
    },
    "/resident_registry/{registryId}": {
      "schema": { "$ref": "#/entities/ResidentRegistryEntry" },
      "description": "Master resident registry used to validate account registration before sign-in"
    },
    "/user_accounts/{username}": {
      "schema": { "$ref": "#/entities/UserAccountLookup" },
      "description": "Registered username and role lookup index"
    }
  }
}
